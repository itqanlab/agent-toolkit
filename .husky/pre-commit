set -e

# Skill spec + portability rules. Fast; runs on every commit.
bash scripts/validate.sh

# Claude Code packaging manifests, when the CLI is available.
if command -v claude >/dev/null 2>&1; then
  claude plugin validate . >/dev/null
  for d in skills/*/; do
    [ -f "$d/.claude-plugin/plugin.json" ] && claude plugin validate "$d" >/dev/null
  done
fi

# Shell scripts, when shellcheck is available.
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck -S warning scripts/*.sh skills/*/scripts/*.sh
fi
