#!/usr/bin/env bash
# Entry point for fleet lanes and the executor tools.
#   fleet <codex|opencode|antigravity|claude-ollama> --model <m> --role <role> --ticket <ID> --cwd <dir> \
#               --brief <file> --out <dir> [--sandbox restricted|full|read-only] \
#               [--timeout <sec>] [--effort <level>] [--dry-run] [--ignore-budget]
#   fleet pick   --role <role> [--kind K] [--triggers a,b] [--urgent] [--attempt N] [--pair-with exe:model]
#   fleet budget [line|status|check EXE|backoff EXE]
#   fleet log    add|backfill ... [--set k=v ...] [--from-result <out>/result.json]
#   fleet stats  [--role R] [--project P]   fleet report --project P --since ISO   fleet selftest
#   fleet cost   [--since ISO] [--ticket T] [--json] [--backfill]   real spend and time per ticket
#   fleet apply  [--dry-run]           fleet seed       fleet models
#   fleet free-models [list|refresh]    the free models opencode serves today
#   fleet status [--json]               budget, slots, lanes, open PRs and CI in one call
#   fleet resources [--json] [--gate heavy|light] [--wait [--max-wait S]]
#                                       the machine's memory, swap, CPU and disk gate (any OS)
#   fleet antigravity-setup             register Plane and the read-only rules with agy, once
#   fleet mcp-exec <name>               start an MCP server from ~/.claude.json (agy runs this)
# Lanes run in run-lane.mjs (node); selection, budget and the log are fleetctl.py (python).
# Docs: core/references/executors.md.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# nvm installs node and opencode per version, and agy lives in ~/.local/bin; make sure a lane
# started from a bare shell (run_in_background) still finds them.
if ! command -v node >/dev/null 2>&1 || ! command -v opencode >/dev/null 2>&1 || ! command -v agy >/dev/null 2>&1; then
  for d in "$HOME"/.nvm/versions/node/*/bin; do [ -d "$d" ] && PATH="$d:$PATH"; done
  PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
  export PATH
fi
case "${1:-}" in
  resources) shift; exec python3 "$here/fleetres.py" "$@" ;;
  pick|budget|log|stats|report|cost|selftest|apply|seed|config|free-models|status) exec python3 "$here/fleetctl.py" "$@" ;;
esac
exec node "$here/run-lane.mjs" "$@"
